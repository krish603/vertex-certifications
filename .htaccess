# Static site served by Apache on GoDaddy cPanel hosting.

DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Clean urls like /about serve about.html, so links shared while the site was
  # on Vercel keep working. Pages still link to .html, so there is no redirect
  # the other way.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On

  # Pages must revalidate so a re-upload is picked up straight away
  ExpiresByType text/html "access plus 0 seconds"

  # Asset filenames carry no content hash, so keep this short
  ExpiresDefault "access plus 1 day"
</IfModule>
